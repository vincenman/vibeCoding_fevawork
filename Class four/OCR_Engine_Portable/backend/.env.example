# Azure OpenAI (vision / OCR) — primary provider matching OCR_minimal_Azure_v4.ipynb
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# OpenRouter (alternative OCR provider)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Active OCR provider: azure | openrouter
OCR_PROVIDER=azure
OCR_MODEL=gpt-4o
OCR_DPI=200
PDF_ENGINE=mistral-ocr

# Job limits
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_JOB=50
TEMP_DIR=/tmp/ocr_jobs
RESULT_TTL_SECONDS=3600

# Output path security (comma-separated; empty = no restriction)
ALLOWED_OUTPUT_BASE_DIRS=
CREATE_OUTPUT_FOLDER_IF_MISSING=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
